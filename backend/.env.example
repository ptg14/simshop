# Real Ed25519 admin public key (32 bytes / 64 hex chars).
# Generate with: openssl genpkey -algorithm ED25519 -out admin.key && cat admin.key
ADMIN_PUBLIC_KEY=<hex of ed25519 public key — 64 hex chars>

# Public origin for CORS. Production MUST set this to the storefront
# origin (no trailing slash). The server defaults to "*" which would
# let any site issue cross-origin admin mutations.
ALLOWED_ORIGIN=https://simshop.example.com

# "production" triggers fail-fast startup when ADMIN_PUBLIC_KEY is empty.
# Leave unset (= development) for local work.
ENV=production

# Comma-separated CIDRs whose X-Forwarded-For will be honored. Empty
# (= default) disables proxy-header trust; only set if behind a known
# reverse proxy. Used by the rate limiter + the upload URL builder.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32

# Public base URL for absolute image URLs. Set this OR TRUSTED_PROXIES
# so /api/upload doesn't have to fall back to the (spoofable) Host
# header.
# BASE_URL=https://simshop.example.com
