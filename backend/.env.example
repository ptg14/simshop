# Real Ed25519 admin public key (32 bytes / 64 hex chars).
# Generate with: openssl genpkey -algorithm ED25519 -out admin.key && cat admin.key
ADMIN_PUBLIC_KEY=<hex of ed25519 public key — 64 hex chars>

# Public origin(s) for CORS. Production MUST set this to the
# storefront origin(s) (no trailing slash). The server defaults to
# "*" which would let any site issue cross-origin admin mutations.
#
# The value is parsed as a comma-separated allowlist when it
# contains a comma; otherwise it's treated as a single origin.
# Use the allowlist form whenever you have multiple origins to
# authorize — for example, a production domain plus a staging
# domain, or a hand-picked set of local Flutter web dev ports.
#
# Credentialed cross-origin requests (admin endpoints carry
# `Authorization: Bearer ...`) cannot use `*` as the Allow-Origin
# response value per the spec. The allowlist form echoes the
# matching entry back verbatim, which IS valid for credentialed
# requests.
#
# Local dev tip: `flutter run -d chrome` picks a random ephemeral
# port (commonly in the 8000-ish range — check the terminal
# output). Pin a few obvious ports here to avoid CORS rejections
# every time the dev port rolls.
# ALLOWED_ORIGIN=https://simshop.example.com
# ALLOWED_ORIGIN=https://simshop.example.com,https://staging.simshop.example.com
ALLOWED_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:9090

# "production" triggers fail-fast startup when ADMIN_PUBLIC_KEY is empty.
# Leave unset (= development) for local work.
ENV=production

# Comma-separated CIDRs whose X-Forwarded-For will be honored. Empty
# (= default) disables proxy-header trust; only set if behind a known
# reverse proxy. Used by the rate limiter + the upload URL builder.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32

# Public base URL for absolute image URLs. Set this OR TRUSTED_PROXIES
# so /api/upload doesn't have to fall back to the (spoofable) Host
# header.
# BASE_URL=https://simshop.example.com
