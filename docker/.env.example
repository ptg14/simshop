# docker/.env.example — Environment cho docker compose (PRODUCTION).
#
# Copy file này thành docker/.env và điền các giá trị thực:
#   cp docker/.env.example docker/.env
#   $EDITOR docker/.env
#
# docker compose đọc docker/.env qua flag --env-file (xem README).
#
# =============================================================================
# QUAN TRỌNG — production checklist
# =============================================================================
# Trước khi `docker compose up -d --build`, hãy chắc chắn:
#   1. Đổi POSTGRES_PASSWORD từ placeholder (compose fail-fast nếu rỗng).
#   2. Đặt ADMIN_PUBLIC_KEY (hex 64 chars) — compose fail-fast nếu rỗng.
#      Lấy bằng: cd backend && go run ./cmd/keygen
#   3. Đặt ALLOWED_ORIGIN = URL FE qua Cloudflare.
#   4. Đặt CF_TUNNEL_TOKEN — compose fail-fast nếu rỗng.
#   5. Set IMAGE_TAG = git SHA hoặc build number để trace được image
#      đang chạy. KHÔNG dùng "latest" cho production rollout.

# =============================================================================
# Image version (cho traceability — nên trùng git SHA)
# =============================================================================
IMAGE_TAG=latest

# =============================================================================
# PostgreSQL
# =============================================================================

# Tên database
POSTGRES_DB=simshop

# User database (tự tạo lần đầu Postgres boot)
POSTGRES_USER=simshop

# Password database. BẮT BUỘC đổi từ placeholder trước khi deploy.
# Docker compose fail với lỗi rõ ràng nếu để rỗng.
POSTGRES_PASSWORD=changeme

# =============================================================================
# Backend
# =============================================================================

# Public key Ed25519 (hex 64 chars) cho admin auth.
# BẮT BUỘC trong production — compose fail-fast nếu rỗng.
# Lấy bằng: cd backend && go run ./cmd/keygen
# Copy hex public key in ra màn hình vào đây.
ADMIN_PUBLIC_KEY=

# CORS: chỉ cho phép origin này gọi API. Đặt URL frontend của bạn
# (vd: https://testweb.dvthang.qzz.io). Phẩy cách nếu nhiều origin.
# BẮT BUỘC trong production — compose fail-fast nếu rỗng.
ALLOWED_ORIGIN=https://testweb.dvthang.qzz.io

# URL public của Backend (qua Cloudflare). Dùng để:
#   1. Build Flutter với API_BASE_URL=...
#   2. Set BASE_URL cho BE sinh absolute URL ảnh upload
# Bỏ trống nếu muốn dùng relative URL (Host header mặc định).
BE_PUBLIC_URL=https://api.dvthang.qzz.io

# (Tùy chọn) URL public của Frontend — nếu khác BE_PUBLIC_URL thì
# đặt rõ ràng để FE build đúng URL API. Mặc định fallback về
# ALLOWED_ORIGIN nếu rỗng.
API_BASE_URL=https://api.dvthang.qzz.io

# Retry khi Postgres chưa ready lúc backend boot (sau server restart).
# attempts × interval_ms = thời gian tối đa chờ. Mặc định: 10 × 1s = 10s.
DB_RETRY_ATTEMPTS=10
DB_RETRY_INTERVAL_MS=1000

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Token từ Cloudflare Zero Trust dashboard.
# Networks → Tunnels → <tunnel của bạn> → "Install cloudflared" → copy token.
# Token có dạng "eyJhIjoi..." (JWT).
# BẮT BUỘC — docker compose fail nếu để rỗng.
CF_TUNNEL_TOKEN=
