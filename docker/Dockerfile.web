# Dockerfile.web — Production multi-stage build cho Flutter web + Nginx.
#
# Stage 1: ghcr.io/cirruslabs/flutter — image Flutter chính thức cho Docker.
#          Build static web assets (release mode, tree-shake debug) vào build/web/.
# Stage 2: nginx:1.27-alpine serve static + SPA fallback + security headers.
#
# Build context: thư mục root của repo (chứa pubspec.yaml, lib/, web/, ...).
# docker compose mount context ở đây:
#   build:
#     context: ..
#     dockerfile: docker/Dockerfile.web
#     args:
#       API_BASE_URL: https://api.example.com

# =============================================================================
# Stage 1: Flutter build (giữ toolchain)
# =============================================================================
# Pin Flutter version cho reproducible build.
FROM ghcr.io/cirruslabs/flutter:3.44.0 AS build

WORKDIR /app

# Tối ưu cache layer: chỉ pub get khi pubspec thay đổi.
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get --no-precompile

# Copy source tối thiểu cần để compile.
# .dockerignore loại bỏ build/, .dart_tool/, *.har, *.db, secrets...
COPY . .

# QUAN TRỌNG: `.env` KHÔNG còn trong pubspec.yaml assets nữa (xem
# comment trong lib/config/api_config.dart). Điều này có nghĩa:
#   - `flutter_dotenv.load()` sẽ throw vì .env không có trong asset
#     manifest. Code đã được viết để xử lý cả NotInitializedError
#     và MissingAsset như "không có runtime value" → fallback qua
#     String.fromEnvironment (compile-time).
#   - Production bundle không còn chứa chuỗi `localhost` nào cả:
#     kể cả fallback literal cũng được đổi thành `''` trong
#     api_config.dart để tree-shaker bỏ nhánh nếu compile-time đã
#     set.

# API_BASE_URL truyền qua build arg (URL Cloudflare của BE).
# --release: tree-shake asserts + debug code → bundle nhỏ nhất.
# --no-tree-shake-icons: tránh lỗi "tree-shaking icons" nổi tiếng
# của Flutter khi build release với icon set lớn (Material icons).
#
# Sau khi Flutter build xong, sed thay placeholder $API_BASE_URL
# trong web/index.html template bằng URL thật — để <link rel="preconnect">
# warm DNS/TLS tới đúng BE host. Nếu API_BASE_URL rỗng (không nên
# xảy ra ở production vì compose inject từ docker/.env), bỏ sed.
ARG API_BASE_URL
RUN if [ -n "$API_BASE_URL" ]; then \
        flutter build web --release \
            --dart-define=API_BASE_URL="$API_BASE_URL" \
            --no-tree-shake-icons \
        && sed -i "s|\$API_BASE_URL|$API_BASE_URL|g" /app/build/web/index.html; \
    else \
        flutter build web --release --no-tree-shake-icons; \
    fi

# Verify output tồn tại (fail-fast nếu build ngầm silently succeed
# nhưng không ra file).
RUN test -f /app/build/web/index.html \
 && test -f /app/build/web/main.dart.js

# =============================================================================
# Stage 2: Nginx runtime (chỉ static + config)
# =============================================================================
FROM nginx:1.27-alpine

# Xóa default config của image cha, bỏ banner version khỏi error pages.
RUN rm -f /etc/nginx/conf.d/default.conf \
    && sed -i 's/# server_tokens off;/server_tokens off;/' /etc/nginx/nginx.conf

# Copy CHỈ build output (static assets). KHÔNG copy source code,
# .dart_tool, pubspec.yaml, .env.
COPY --from=build /app/build/web /usr/share/nginx/html

# Copy production nginx config (SPA fallback + cache headers tuned
# cho Cloudflare CDN + security headers).
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck nhẹ — xác nhận nginx + content serve được.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -qO- http://localhost/healthz || exit 1
